# Generated by Gutter (tools/apps.py). Do not edit; rerun `gutter theme apply` instead.
[ColorEffects:Disabled]
Color={{ paper_alt }}
ColorAmount=0.5
ColorEffect=3
ContrastAmount=0
ContrastEffect=0
IntensityAmount=0
IntensityEffect=0

[ColorEffects:Inactive]
