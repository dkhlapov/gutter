# Generated by Gutter (tools/apps.py). Do not edit; rerun `gutter theme apply` instead.

# Main background and text
theme[main_bg]={{ paper }}
theme[main_fg]={{ text }}

# Title color for boxes
theme[title]={{ text }}

# Highlight color for keyboard shortcuts
theme[hi_fg]={{ accent_text }}

# Selected item in the processes box
theme[selected_bg]={{ active }}
theme[selected_fg]={{ on_active }}

# Inactive/disabled text
theme[inactive_fg]={{ muted_text }}

# Text on top of graphs, and misc processes box colors
theme[graph_text]={{ special_text }}
theme[proc_misc]={{ special_text }}

# Background of the percentage meters
theme[meter_bg]={{ muted }}

# CPU, Memory, Network, Proc box outlines
theme[cpu_box]={{ ink }}
theme[mem_box]={{ ink }}
theme[net_box]={{ ink }}
theme[proc_box]={{ ink }}

# Box divider line and small boxes line color
theme[div_line]={{ ink }}

# Temperature graph (lime -> sun -> coral)
theme[temp_start]={{ lime }}
theme[temp_mid]={{ sun }}
theme[temp_end]={{ coral }}

# CPU graph (teal -> magenta -> pink)
theme[cpu_start]={{ teal }}
theme[cpu_mid]={{ magenta }}
theme[cpu_end]={{ pink }}

# Mem/Disk free meter (lime -> teal -> navy)
theme[free_start]={{ lime }}
theme[free_mid]={{ teal }}
theme[free_end]={{ navy }}

# Mem/Disk cached meter (teal -> navy -> magenta)
theme[cached_start]={{ teal }}
theme[cached_mid]={{ navy }}
theme[cached_end]={{ magenta }}

# Mem/Disk available meter (sun -> pink -> coral)
theme[available_start]={{ sun }}
theme[available_mid]={{ pink }}
theme[available_end]={{ coral }}

# Mem/Disk used meter (lime -> teal -> navy)
theme[used_start]={{ lime }}
theme[used_mid]={{ teal }}
theme[used_end]={{ navy }}

# Download graph (sun -> pink -> coral)
theme[download_start]={{ sun }}
theme[download_mid]={{ pink }}
theme[download_end]={{ coral }}

# Upload graph (lime -> teal -> navy)
theme[upload_start]={{ lime }}
theme[upload_mid]={{ teal }}
theme[upload_end]={{ navy }}

# Process box gradient for threads, mem and cpu usage (teal -> magenta -> pink)
theme[process_start]={{ teal }}
theme[process_mid]={{ magenta }}
theme[process_end]={{ pink }}
